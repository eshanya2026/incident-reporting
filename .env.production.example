# ---------------------------------------------------------------------------
# Production settings for docker-compose.yml
#
#   cp .env.production.example .env.production
#   (edit .env.production — it is git-ignored, keep it private)
#   docker compose --env-file .env.production up -d --build
#
# Ports: web app -> 1006, API -> 2006, MongoDB -> 3006 (fixed in docker-compose.yml)
# ---------------------------------------------------------------------------

# Public addresses users reach the app at. Use the server's IP or DNS name.
# Switch to https:// once TLS is set up (the login cookie is then marked Secure automatically).
APP_URL=http://SERVER_IP_OR_DOMAIN:1006
API_URL=http://SERVER_IP_OR_DOMAIN:2006

# REQUIRED: unique random secrets, at least 32 characters, different from each other.
# The server refuses to start with missing, short or example values.
# Generate each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h

# MongoDB is published on host port 3006, bound to this machine only. The database has no login,
# so only change this to 0.0.0.0 if a firewall limits port 3006 to trusted machines.
MONGO_BIND=127.0.0.1

# Attachments
MAX_FILE_SIZE_MB=10

# Email notifications (optional)
EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Adhiparasakthi Safety Portal <noreply@adhiparasakthi.hospital>"

# WhatsApp notifications via WATI (optional) — see docs/whatsapp-template.md
WHATSAPP_NOTIFICATIONS=false
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_TEMPLATE_NAME=incident_assigned_hod
