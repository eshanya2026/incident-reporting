# Application Environment
NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/incident_db

# JWT Secrets & Security
JWT_ACCESS_SECRET=adhiparasakthi_access_super_secret_key_2026_change_in_prod
JWT_REFRESH_SECRET=adhiparasakthi_refresh_super_secret_key_2026_change_in_prod
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=12h

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Storage Configuration
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=uploads
MAX_FILE_SIZE_MB=10

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@adhiparasakthi.hospital
SMTP_PASSWORD=dummy_smtp_password
SMTP_FROM="Adhiparasakthi Safety Portal <noreply@adhiparasakthi.hospital>"
# Also email notifications to users (in-app notifications are always on)
EMAIL_NOTIFICATIONS=false

# Frontend & API URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
# Reverse proxies in front of the API (1 behind the bundled Nginx, 0 when clients connect directly)
TRUST_PROXY=0
